# ==============================================================================
# Model & Endpoint Configuration (OpenAI-compatible)
# ==============================================================================
# Option A: Local Ollama (Default - No API Key required)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b

# Option B: Hosted Open-Source Inference via OpenRouter (Uncomment to use)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-openrouter-api-key
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct

# ==============================================================================
# Server & Client Endpoints
# ==============================================================================
API_BASE_URL=http://localhost:8000
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# ==============================================================================
# RAG & Vector Store Configuration
# ==============================================================================
VECTOR_DB_PATH=.data/vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_COLLECTION=customer-support
RAG_TOP_K=3
